# Copy this file, name the copy ".env.local", and fill in the two values.
# Find both in your Supabase dashboard: open your project → click "Connect"
# at the top (or Project Settings → API Keys).
#
# Both values are safe to use in the browser. NEVER put the "service_role"
# or "secret" key in this project.

# Your project's address, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "publishable" key (starts with sb_publishable_).
# Older projects: the "anon public" key works here too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
